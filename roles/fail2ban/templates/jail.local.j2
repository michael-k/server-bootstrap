# Fail2ban Jail Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# This configuration monitors SSH authentication logs and bans IPs
# with repeated failed login attempts.
#
# Requirements: 10.2, 10.3, 10.4, 10.5

[DEFAULT]
# Ban action - use nftables for firewall integration (Requirement 10.5)
banaction = {{ fail2ban_banaction }}
banaction_allports = {{ fail2ban_banaction }}

# Default ban time for all jails (Requirement 10.4)
bantime = {{ fail2ban_ban_time }}

# Time window for counting failed attempts (Requirement 10.3)
findtime = {{ fail2ban_find_time }}

# Maximum number of failed attempts before ban (Requirement 10.3)
maxretry = {{ fail2ban_max_retry }}

# Backend for log monitoring
backend = {{ fail2ban_ssh_backend }}

[sshd]
# Enable SSH monitoring (Requirement 10.2)
enabled = {{ 'true' if fail2ban_ssh_enabled else 'false' }}

# Monitor SSH authentication logs via journald
# This works with systemd-based systems using journald for logging
# Use aggressive mode to catch all failure patterns including
# "Connection closed by authenticating user" from modern OpenSSH clients
filter = sshd[mode=aggressive]

# Log path - journald backend reads from systemd journal
# No explicit logpath needed when using systemd backend

# Port to monitor (inherited from SSH configuration)
port = {{ ssh_port | default(22) }}

# Protocol
protocol = tcp

# Maximum number of failed attempts before ban
# Inherits from DEFAULT if not specified
maxretry = {{ fail2ban_max_retry }}

# Ban time duration
# Inherits from DEFAULT if not specified
bantime = {{ fail2ban_ban_time }}

# Time window for counting failures
# Inherits from DEFAULT if not specified
findtime = {{ fail2ban_find_time }}
