# Fail2ban Jail Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# This file is read after the packaged jail.conf and after jail.d/*.conf, and
# before jail.d/*.local. Within that merge, a setting in a jail's own section
# beats the same setting in the DEFAULT section, whichever file each came
# from - which is why F2B-12 restates three values below, and why F2B-7's
# backend does not reach the sshd jail. The drop-in that decides that, and
# two other things this file appears to decide, is
# jail.d/defaults-debian.conf. See specs/fail2ban/design.md.
#
# Requirements: F2B-4, F2B-5, F2B-6, F2B-7, F2B-8, F2B-9, F2B-10, F2B-11,
# F2B-12

[DEFAULT]
# F2B-11: the ban action, stated here rather than inherited. Debian's
# jail.d/defaults-debian.conf already sets banaction = nftables (type
# multiport by default), so this produces the same action under a different,
# and now deprecated, name. The action builds a table of its own - inet
# f2b-table, input chain at priority -1 - so it never edits the firewall's
# ruleset. Setting banaction_allports to the same value replaces the
# package's nftables[type=allports] with a port-scoped action; no jail here
# uses it. See specs/fail2ban/design.md.
banaction = {{ fail2ban_banaction }}
banaction_allports = {{ fail2ban_banaction }}

# F2B-10: how long a ban is held.
bantime = {{ fail2ban_ban_time }}

# F2B-9: the window failures are counted within.
findtime = {{ fail2ban_find_time }}

# F2B-9: how many matched failures from one source trigger a ban.
maxretry = {{ fail2ban_max_retry }}

# F2B-7: the default backend for any jail that does not set its own. The ssh
# jail does get one of its own, from jail.d/defaults-debian.conf, so this
# line does not decide what that jail reads - F2B-6 does, and it is satisfied
# by that drop-in rather than by this value.
backend = {{ fail2ban_ssh_backend }}

[sshd]
# F2B-4: with fail2ban_ssh_enabled false this jail is not created and
# fail2ban runs supervising nothing.
enabled = {{ 'true' if fail2ban_ssh_enabled else 'false' }}

# F2B-6: the jail reads sshd's authentication records from the systemd
# journal. This line does not set that - jail.d/defaults-debian.conf does,
# with [sshd] backend = systemd and a journalmatch that is a disjunction
# (_SYSTEMD_UNIT=ssh.service OR _COMM=sshd), not a scoping conjunction. No
# logpath is set, and none would help: nothing in this project writes sshd's
# records to a file, and a file backend with no file fails the start
# outright rather than quietly - measured.
#
# F2B-8: aggressive mode. The default mode mostly sees invalid-user failures,
# because a valid user's failed public key offer is explicitly not counted.
# Aggressive adds the sources that never finish a handshake ("Did not receive
# identification string", the login grace timeout, "Connection closed by
# authenticating user" from modern OpenSSH clients) and the ones this
# project's own algorithm restrictions refuse ("Unable to negotiate ... no
# matching ... found"). The cost is that a legitimate operator on an old
# client is counted the same way.
filter = sshd[mode=aggressive]

# F2B-5: the port a ban blocks - not the source the jail reads. Taken from
# ssh_port so that the jail and the daemon cannot name different ports.
port = {{ ssh_port | default(22) }}

# F2B-5: bans are scoped to TCP.
protocol = tcp

# F2B-12: the next three are deliberately restated here rather than inherited
# from the DEFAULT section. A jail-level setting outranks DEFAULT from every
# file fail2ban reads, including a jail.d/*.local drop-in read after this
# one, so these three lines are what pins this jail's counters to this
# project's variables. Both copies render from the same variable and so
# cannot disagree.
maxretry = {{ fail2ban_max_retry }}

bantime = {{ fail2ban_ban_time }}

findtime = {{ fail2ban_find_time }}
