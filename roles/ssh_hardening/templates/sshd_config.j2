# SSH Daemon Configuration - Hardened
# Generated by Ansible - DO NOT EDIT MANUALLY
# VPS Bootstrap Playbook - ssh_hardening role
#
# Requirements: SSH-1, SSH-2, SSH-3, SSH-4, SSH-5, SSH-6, SSH-7, SSH-8,
# SSH-9, SSH-10, SSH-11, SSH-12, SSH-13, SSH-14, SSH-15, SSH-16, SSH-18.
# This file is the whole of sshd's configuration: it carries no Include of
# /etc/ssh/sshd_config.d/, so a drop-in placed there has no effect.

# Network Configuration
# SSH-13: the configured listening port
Port {{ ssh_port }}
AddressFamily any
{% if tailscale_enabled and tailscale_ipv4 is defined and tailscale_ipv6 is defined %}
# SSH-18, Tailscale branch: bound to the Tailscale interface addresses only,
# so sshd is absent from every publicly reachable address, not just filtered.
ListenAddress {{ tailscale_ipv4 }}
ListenAddress {{ tailscale_ipv6 }}
{% else %}
# SSH-18, open branch: bound to all interfaces — taken when Tailscale is not
# enrolled, or has published no addresses to bind to.
ListenAddress {{ ssh_listen_address_ipv4 }}
ListenAddress {{ ssh_listen_address_ipv6 }}
{% endif %}

# Authentication Configuration
# SSH-2: root has no remote login path, by any method.
PermitRootLogin no
# SSH-1: no password is ever accepted from the network.
PasswordAuthentication no
# SSH-3: public keys are the one method that remains.
PubkeyAuthentication yes
# SSH-4: an account with no password set is not loginable.
PermitEmptyPasswords no
# SSH-3: closes the keyboard-interactive method too, so the PAM stack below
# cannot offer a password prompt over the network.
ChallengeResponseAuthentication no
UsePAM yes

# SSH-12: login is restricted to members of this one group. Purpose-specific
# deployments grant access by adding an account to it.
AllowGroups {{ ssh_access_group }}

# Session Security
# SSH-14: authentication attempts permitted within one connection.
MaxAuthTries {{ ssh_max_auth_tries }}
# SSH-15: how long an unauthenticated connection may be held open.
LoginGraceTime {{ ssh_login_grace_time }}
# SSH-16: keepalive probe interval and the number of unanswered probes
# tolerated before the session is dropped.
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}

# Cryptographic Algorithm Restrictions
# SSH-5: the key exchange algorithms sshd allows. The client's order picks
# among them, so the membership of this list is the policy, not its order.
KexAlgorithms {{ ssh_kex_algorithms | join(',') }}

# SSH-6: ciphers that authenticate the ciphertext as part of decrypting it.
Ciphers {{ ssh_ciphers | join(',') }}

# SSH-7: Encrypt-Then-MAC variants only.
MACs {{ ssh_macs | join(',') }}

# Feature Disablement
# SSH-8: no remote display connection back across the channel.
X11Forwarding no
# SSH-9: no relaying onward to anything this host can reach.
AllowTcpForwarding no
# SSH-10: no use of the connecting operator's own keys from this host.
AllowAgentForwarding no
# SSH-11: no tun device, so no VPN built out of a login session.
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no

# Additional Security Settings
StrictModes yes
MaxSessions 10
TCPKeepAlive yes
Compression no
UseDNS no
PrintMotd no
PrintLastLog yes
AcceptEnv LANG LC_*

# Subsystems
Subsystem sftp /usr/lib/openssh/sftp-server
