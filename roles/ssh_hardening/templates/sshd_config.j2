# SSH Daemon Configuration - Hardened
# Generated by Ansible - DO NOT EDIT MANUALLY
# VPS Bootstrap Playbook - ssh_hardening role

# Network Configuration
Port {{ ssh_port }}
AddressFamily any
{% if tailscale_enabled and tailscale_ipv4 is defined and tailscale_ipv6 is defined %}
# SSH restricted to Tailscale interface (Requirement 5.2)
ListenAddress {{ tailscale_ipv4 }}
ListenAddress {{ tailscale_ipv6 }}
{% else %}
# SSH listening on all interfaces (Requirement 5.3)
ListenAddress {{ ssh_listen_address_ipv4 }}
ListenAddress {{ ssh_listen_address_ipv6 }}
{% endif %}

# Authentication Configuration (Requirements 3.1, 3.2, 3.14, 3.18)
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
ChallengeResponseAuthentication no
UsePAM yes

# User Access Restriction (Requirement 3.10)
AllowUsers {{ ssh_allowed_users | join(' ') }}

# Session Security (Requirements 3.15, 3.16, 3.17)
MaxAuthTries {{ ssh_max_auth_tries }}
LoginGraceTime {{ ssh_login_grace_time }}
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}

# Cryptographic Algorithm Restrictions (Requirements 3.3, 3.4, 3.5)
# Modern elliptic curve key exchange only
KexAlgorithms {{ ssh_kex_algorithms | join(',') }}

# Authenticated encryption (AEAD) ciphers only
Ciphers {{ ssh_ciphers | join(',') }}

# Encrypt-Then-MAC variants only
MACs {{ ssh_macs | join(',') }}

# Feature Disablement (Requirements 3.6, 3.7, 3.8, 3.9)
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no

# Additional Security Settings
StrictModes yes
MaxSessions 10
TCPKeepAlive yes
Compression no
UseDNS no
PrintMotd no
PrintLastLog yes
AcceptEnv LANG LC_*

# Subsystems
Subsystem sftp /usr/lib/openssh/sftp-server
