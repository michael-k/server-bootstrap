# Hardened /tmp mount options
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Drop-in override for the base tmp.mount unit. Works whether /tmp is
# disk-backed or tmpfs.
#
# FS-1: mounted with noexec,nosuid,nodev — the drop-in strategy, used when
# a tmp.mount unit already exists on the host.
# FS-4: a systemd drop-in, not an /etc/fstab entry.

[Mount]
Options=mode=1777,strictatime,noexec,nosuid,nodev
