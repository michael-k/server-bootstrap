# Hardened /var/tmp bind-mount to /tmp
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Bind-mounts /var/tmp to /tmp so it inherits the same noexec,nosuid,nodev
# restrictions, eliminating /var/tmp as a bypass path.

[Unit]
Description=Hardened /var/tmp mount (bind to /tmp)
Conflicts=umount.target
Before=local-fs.target umount.target
After=tmp.mount
Requires=tmp.mount

[Mount]
What=/tmp
Where=/var/tmp
Type=none
Options=bind,rw,noexec,nosuid,nodev

[Install]
WantedBy=local-fs.target
