# Hardened /tmp bind-mount
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Bind-mounts /tmp onto itself. Uses disk (not tmpfs) to avoid RAM pressure.
#
# FS-1: mounted with noexec,nosuid,nodev — the bind-mount unit strategy,
# used when no tmp.mount unit already exists on the host.
# FS-4: a systemd mount unit, not an /etc/fstab entry.

[Unit]
Description=Hardened /tmp mount
Conflicts=umount.target
Before=local-fs.target umount.target
After=swap.target

[Mount]
What=/tmp
Where=/tmp
Type=none
Options=bind,rw,noexec,nosuid,nodev

[Install]
WantedBy=local-fs.target
