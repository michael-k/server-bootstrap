# Hardened /tmp bind-mount
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Bind-mounts /tmp onto itself with noexec, nosuid, nodev to prevent
# execution of uploaded payloads. Uses disk (not tmpfs) to avoid RAM pressure.

[Unit]
Description=Hardened /tmp mount
Conflicts=umount.target
Before=local-fs.target umount.target
After=swap.target

[Mount]
What=/tmp
Where=/tmp
Type=none
Options=bind,rw,noexec,nosuid,nodev

[Install]
WantedBy=local-fs.target
