#!/usr/sbin/nft -f
# NFTables Firewall Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# This configuration implements a dual-stack (IPv4 + IPv6) stateful firewall
# with default-deny policies and explicit allow rules.
#
# Requirements: FW-2, FW-3, FW-4, FW-5, FW-6, FW-7, FW-8, FW-9, FW-10, FW-11,
# FW-12, FW-13, FW-14, FW-15 and FW-21. The port-knocking branch below belongs
# to a separate spec that has not been written yet, so its sets and rules
# carry no requirement IDs.

# FW-15: the deployed ruleset replaces whatever the kernel is holding rather
# than adding to it, so a re-run converges instead of accumulating rules. The
# flush is part of the same transaction as everything below, so a file that
# fails to load leaves the previous ruleset untouched — but it also removes
# tables this file does not define, which is how a reload discards another
# tool's rules. See the firewall design's failure modes.
flush ruleset

# FW-2: one inet table carries both address families, so every policy and
# every rule below governs IPv4 and IPv6 identically — there is no second,
# looser table for one of them to drift into.
table inet filter {
{% if not (firewall_tailscale_enabled | bool) and (firewall_port_knocking_enabled | bool) %}
    # Port knocking sets — track knock sequence progress per source IP
    # Sets must be at table level (outside chains) per NFTables syntax
{% for af, addr_type in [('4', 'ipv4_addr'), ('6', 'ipv6_addr')] %}
    set knock{{ af }}_stage1 { type {{ addr_type }}; flags timeout; timeout {{ firewall_port_knocking_stage_timeout }}s; }
    set knock{{ af }}_stage2 { type {{ addr_type }}; flags timeout; timeout {{ firewall_port_knocking_stage_timeout }}s; }
    set knock{{ af }}_passed { type {{ addr_type }}; flags timeout; timeout {{ firewall_port_knocking_timeout }}s; }
{% endfor %}

{% endif %}
    # Input chain - handles incoming traffic
    # FW-3: the policy is what decides every packet no rule below matched, so
    # anything this file forgets is refused rather than admitted.
    chain input {
        type filter hook input priority 0; policy drop;

        # FW-6: this is the rule that makes the firewall stateful — replies to
        # connections this host opened, and their related flows, are admitted
        # without a rule per service. It is first because most packets match
        # it, and because an outbound-initiated exchange must never depend on
        # the service rules further down.
        ct state established,related accept

        # FW-7: local services address each other over the loopback
        # interface, which the drop policy would otherwise break.
        iif lo accept

        # FW-8: ICMPv4, for ping and path MTU discovery.
        ip protocol icmp accept
        # FW-9: ICMPv6, which also carries neighbour discovery and router
        # advertisement — dropping it breaks IPv6 itself, not just diagnostics.
        ip6 nexthdr icmpv6 accept

{% if firewall_tailscale_enabled | bool %}
        # Tailscale VPN is enabled - reach this host over the tailnet only

        # FW-10, FW-11, FW-14: SSH is admitted only on packets that arrived
        # over the tailnet interface. Matching the interface rather than a
        # source address means a packet from the public interface claiming a
        # tailnet source does not match.
        iifname "{{ firewall_tailscale_interface }}" tcp dport {{ firewall_ssh_port }} accept

        # FW-12: Tailscale's WireGuard traffic arrives from the internet on a
        # public interface, so this rule is deliberately not narrowed - the
        # tunnel that the rule above restricts SSH to cannot come up without
        # it. It is the one port this host offers the open internet.
        udp dport {{ firewall_wireguard_port }} accept
{% elif firewall_port_knocking_enabled | bool %}
        # Port knocking is enabled - SSH only after correct knock sequence
        # Knock sequence: {{ firewall_port_knocking_sequence | join(' -> ') }}
{% for af, saddr in [('4', 'ip saddr'), ('6', 'ip6 saddr')] %}

        # IPv{{ af }} knock sequence
        tcp dport {{ firewall_port_knocking_sequence[0] }} add @knock{{ af }}_stage1 { {{ saddr }} }
        tcp dport {{ firewall_port_knocking_sequence[1] }} {{ saddr }} @knock{{ af }}_stage1 add @knock{{ af }}_stage2 { {{ saddr }} }
        tcp dport {{ firewall_port_knocking_sequence[2] }} {{ saddr }} @knock{{ af }}_stage2 add @knock{{ af }}_passed { {{ saddr }} }
{% endfor %}

        # Drop knock port packets after set processing
        tcp dport { {{ firewall_port_knocking_sequence | join(', ') }} } drop

        # SSH access (only for IPs that completed knock sequence)
        tcp dport {{ firewall_ssh_port }} ip saddr @knock4_passed accept
        tcp dport {{ firewall_ssh_port }} ip6 saddr @knock6_passed accept
{% else %}
        # FW-13, FW-14: Tailscale and port knocking are both off, so there is
        # no narrower path to this host and SSH is admitted on every
        # interface. That is exposure, and it is exposure a requirement
        # states outright rather than exposure left over by omission.
        tcp dport {{ firewall_ssh_port }} accept
{% endif %}

        # Log dropped packets (optional, for debugging)
        # Uncomment to enable logging:
        # log prefix "nftables-drop: " drop
    }

    # Forward chain - handles forwarded traffic
    # FW-4: this host routes nothing for anybody, and the chain is left empty
    # so that stays true without a rule having to say so.
    chain forward {
        type filter hook forward priority 0; policy drop;

        # No forwarding rules needed for this configuration
        # All forwarding is blocked by default
    }

    # Output chain - handles outgoing traffic
    # FW-5: outbound traffic is not filtered. Egress control is a policy this
    # bootstrap does not attempt; FW-6 is what lets the replies back in.
    chain output {
        type filter hook output priority 0; policy accept;
    }
}

# FW-21: purpose-specific rules from the drop-in directory, appended to the
# chains above after everything this file defines. No chain here ends in a
# terminal rule, so an appended accept is still reached; only the drop policy
# comes after it.
# Files must use "add rule" syntax (not "flush ruleset" or "table ... { }") since
# the base table already exists. Example:
#   add rule inet filter input tcp dport 443 accept
# A glob that matches nothing is not an error, so an absent or empty
# directory leaves this ruleset exactly as written.
include "/etc/nftables.d/*.nft"
