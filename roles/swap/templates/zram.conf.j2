# Zram Swap Configuration
# Managed by Ansible - do not edit manually
#
# Zram creates a compressed block device in RAM that can be used as swap space.
# This provides faster swap performance than disk-based swap with the trade-off
# of using some RAM for compression overhead.
#
# Requirements: 13.4, 13.5, 13.9

# Requirement 13.4: Zram device size specification
# Can be specified as:
#   - Percentage of RAM (e.g., 50 for 50% of total RAM)
#   - Absolute size in MB (e.g., 2048 for 2GB)
{% if zram_size.endswith('%') %}
PERCENTAGE={{ zram_size.rstrip('%') }}
{% else %}
# Convert size specification to MB
{% if zram_size.endswith('G') or zram_size.endswith('g') %}
SIZE={{ (zram_size.rstrip('Gg') | int) * 1024 }}
{% elif zram_size.endswith('M') or zram_size.endswith('m') %}
SIZE={{ zram_size.rstrip('Mm') | int }}
{% else %}
# Default to percentage if format is unclear
PERCENTAGE=50
{% endif %}
{% endif %}

# Requirement 13.5: Compression algorithm
# lz4 is chosen for its excellent balance of speed and compression ratio
# Other options: lzo, zstd (but lz4 is fastest)
ALGO=lz4

# Requirement 13.9: Swap priority
# Higher priority than disk swap (100 vs 10) ensures zram is used first
# Zram is faster than disk swap, so it should be preferred
PRIORITY={{ zram_swap_priority }}
