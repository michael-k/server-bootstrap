{
    "kiroAgent.commandDenylist": [
        "commit",
        "--force",
        "--no-gpg-sign",
        "rm -rf",
        "sudo"
    ],
    "kiroAgent.configureMCP": "Disabled",
    "kiroAgent.trustedCommands": [
        "make ansible-lint",
        "make ansible-lint-fix",
        "make python-lint",
        "make python-lint 2>&1",
        "make python-lint-fix",
        "make test",
        "make test-integration",
        "make test-property",
        "make test-unit",
        "make test-unit 2>&1",
        "git diff",
        "git diff --cached",
        "git diff --stat",
        "git log --oneline -5",
        "git status",
        "git status --porcelain",
        "git status --short",
        "git add .",
        "uv run ansible-playbook --syntax-check playbooks/site.yml"
    ],
    "python-envs.workspaceSearchPaths": ["./**/.venv"]
}