{
  "enabled": true,
  "name": "Commit on Task Completion",
  "description": "Automatically lint, stage, and commit all changes when a task status is set to completed, following the git workflow guidelines",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "A task was just completed:\n\n1. Check if there are any uncommitted changes with `git status`\n2. If there are changes:\n   - Lint Ansible files: `make ansible-lint-fix` (if any .yml files in roles/ or playbooks/ changed)\n   - Lint Python files: `make python-lint-fix` (if any .py files changed)\n   - Stage all changes: `git add .`\n   - Create a commit with proper format including task number, changes, and requirements\n   - Never use --no-gpg-sign flag\n3. If no changes, just acknowledge the task completion\n4. Stop, you're done.  Don't write a summary.\n\nThe commit message should follow the format:\n```\nTask X.Y: [description]\n\nChanges:\n- Bullet point 1\n- Bullet point 2\n\n[Impact statement]\n\nRequirements: X.Y, X.Z\n```"
  },
  "workspaceFolderName": "server-bootstrap",
  "shortName": "commit-on-task-complete"
}