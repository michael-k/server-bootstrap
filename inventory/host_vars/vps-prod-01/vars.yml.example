---
# ============================================================================
# Host Variables - vps-prod-01
# ============================================================================
#
# This file contains NON-SECRET configuration that is UNIQUE to this host.
# For secrets, use vault.yml in the same directory.
#
# SETUP INSTRUCTIONS:
# -------------------
# 1. Copy this file to create your actual host vars:
#    cp inventory/host_vars/vps-prod-01/vars.yml.example inventory/host_vars/vps-prod-01/vars.yml
#
# 2. Edit the file with your host-specific configuration
#
# This example shows how to override variables for a single host.
# Variables defined here have HIGH precedence and override both
# group_vars/all.yml and group_vars/<group>.yml
#
# ============================================================================

# ==============================================================================
# HOST-SPECIFIC CONFIGURATION
# ==============================================================================

# Example: Set a unique hostname for this specific server
system_hostname: "vps-prod-01"

# Example: This server might need different swap settings
zram_enabled: true
zram_size: "2G"
disk_swap_size: ""  # No disk swap on this host

# Example: This server might use a non-standard SSH port
ssh_port: 2222

# Example: This server might have Tailscale enabled while others don't
tailscale_enabled: true
tailscale_control_server: "https://headscale.example.com"
tailscale_pre_auth_key: "{{ vault_tailscale_pre_auth_key }}"

# Example: This server might need different NTP servers (closer geographically)
ntp_servers:
  - "time.cloudflare.com"
  - "time.google.com"

# ==============================================================================
# VARIABLE PRECEDENCE (lowest to highest)
# ==============================================================================
#
# 1. Role defaults (roles/*/defaults/main.yml)
# 2. inventory/group_vars/all.yml
# 3. inventory/group_vars/<group>.yml
# 4. inventory/host_vars/<hostname>/vars.yml      ← THIS FILE
# 5. inventory/host_vars/<hostname>/vault.yml     ← Highest precedence (secrets)
#
# Variables defined in this file will override the same variables defined
# in group_vars, but will be overridden by variables in vault.yml.
#
# ==============================================================================
# USAGE EXAMPLE
# ==============================================================================
#
# Directory structure:
#   inventory/
#   ├── production.example                 # Inventory file with host definitions
#   ├── vault.yml.example                  # Encrypted shared secrets
#   ├── group_vars/
#   │   ├── all.yml.example                # Variables for all hosts
#   │   └── webservers.yml                 # Variables for webservers group
#   └── host_vars/
#       ├── vps-prod-01/
#       │   ├── vars.yml                   # Host-specific configuration
#       │   └── vault.yml                  # Host-specific secrets (encrypted)
#       └── vps-prod-02/
#           ├── vars.yml                   # Host-specific configuration
#           └── vault.yml                  # Host-specific secrets (encrypted)
#
# This allows you to:
# - Set common defaults in group_vars/all.yml
# - Override for specific groups in group_vars/<group>.yml
# - Override for specific hosts in host_vars/<hostname>/vars.yml
# - Store host-specific secrets in host_vars/<hostname>/vault.yml
